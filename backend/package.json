{
  "name": "motorsport-iq-backend",
  "version": "1.0.0",
  "description": "Motorsport IQ Backend - Real-time F1 prediction game server",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "worker:scoring": "node dist/workers/scoringWorker.js",
    "test": "jest",
    "test:e2e": "jest --config jest.e2e.config.js",
    "lint": "eslint src/**/*.ts",
    "loadtest:100": "node loadtest/runSummary.js loadtest/scenario-100-live.json",
    "loadtest:250": "node loadtest/runSummary.js loadtest/scenario-250-live.json",
    "loadtest:500": "node loadtest/runSummary.js loadtest/scenario-500-live.json",
    "loadtest:5000": "node loadtest/runSummary.js loadtest/scenario-5000-live.json",
    "loadtest:smoke": "node loadtest/harness.js --mode lobbies --target 100 --users-per-lobby 10",
    "loadtest:smoke:players": "node loadtest/harness.js --mode players --target 100"
  },
  "keywords": [
    "f1",
    "motorsport",
    "prediction",
    "game"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@microsoft/signalr": "^10.0.11",
    "@socket.io/redis-adapter": "^8.3.0",
    "@supabase/supabase-js": "^2.112.2",
    "@types/bad-words": "^3.0.3",
    "bad-words": "^4.1.5",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.0.9",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "groq-sdk": "^1.5.0",
    "ioredis": "^6.0.0",
    "socket.io": "^4.8.3",
    "uuid": "^14.0.1",
    "web-push": "^3.6.7",
    "ws": "^8.21.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.2",
    "@types/uuid": "^11.0.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "eslint": "^10.8.0",
    "globals": "^17.9.0",
    "jest": "^30.2.0",
    "nodemon": "^3.1.14",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.66.0"
  }
}
